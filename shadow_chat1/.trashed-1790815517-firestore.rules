rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/config/app).data.ownerUid == request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isMember(roomId, memberId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(memberId));
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId}/contacts/{contactId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/{contactCollection}/{contactId} {
      allow read, write: if isSelf(userId)
        && (contactCollection == 'regularContacts'
          || contactCollection == 'groupContacts'
          || contactCollection == 'roomContacts');
    }

    match /users/{userId}/security/appLock {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.passwordHash is string
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }

    match /users/{userId}/chatSecurity/{chatId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/settings/{settingId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /rooms/{roomId}/members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.addedBy == request.auth.uid
        && memberId != request.auth.uid;
      allow update, delete: if false;
    }

    match /config/app {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/secretGroup {
      allow read: if signedIn();
      allow create, update: if isOwner()
        && request.resource.data.passwordHash is string;
      allow delete: if false;
    }

    match /config/secretRoom {
      allow read: if signedIn();
      allow create, update: if isOwner()
        && request.resource.data.codeHash is string;
      allow delete: if false;
    }
  }
}
